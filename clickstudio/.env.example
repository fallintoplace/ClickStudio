# Prefer npm run init:env, which generates unique local secrets into ignored .env.
HOST=127.0.0.1
CLICKSTUDIO_API_PORT=8080
APP_ORIGIN=http://localhost:5173
DATA_DIR=.data
CLICKSTUDIO_TOKEN=replace-with-at-least-32-random-characters
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=default
CLICKHOUSE_USER=clickstudio_reader
CLICKHOUSE_PASSWORD=replace-with-a-random-reader-password
CLICKHOUSE_WRITER_USER=clickstudio_writer
CLICKHOUSE_WRITER_PASSWORD=replace-with-a-different-random-password
CLICKHOUSE_IMPORT_TABLES=default.import_events
CLICKHOUSE_ADMIN_USER=clickstudio_admin
CLICKHOUSE_ADMIN_PASSWORD=replace-with-another-random-password
DEMO_MODE=false
# Do not put either key in a VITE_* variable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_INPUT_TOKENS=48000
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
AI_SENSITIVE_COLUMNS=password,token,secret,api_key
# CONNECTIONS_FILE=examples/connections.json
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
# TRACE_URL_TEMPLATE=https://your-observability.example/traces/{traceId}
