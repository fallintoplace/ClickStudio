{
  "name": "clickstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "node scripts/dev.mjs",
    "start": "tsx --env-file-if-exists=.env src/backend/app/start.ts",
    "build": "npm run typecheck && npm run build:app",
    "build:app": "vite build && tsc -p tsconfig.server.json && node scripts/copy-parser-vendor.mjs",
    "start:production": "node --env-file-if-exists=.env dist/src/backend/app/start.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.e2e.json",
    "test": "npm run test:core && npm run test:workspace",
    "test:core": "tsc -p tsconfig.core.json && node --test tests/core/*.test.mjs",
    "test:integration": "tsx --env-file-if-exists=.env --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:core": "playwright test tests/e2e/core-workflows.spec.ts",
    "check": "npm run review",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "eval:assistant": "tsx --env-file-if-exists=.env scripts/eval-assistant.ts",
    "init:env": "node scripts/init-env.mjs",
    "db:setup": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:workspace": "tsc -p tsconfig.workspace.json && node --test tests/workspace/*.test.mjs",
    "coverage:core": "tsc -p tsconfig.core.json && node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-functions=70 --test-coverage-branches=60 --test-coverage-include='.core-build/src/backend/**/*.js' --test-coverage-include='.core-build/src/shared/**/*.js' --test-coverage-include='.core-build/src/frontend/**/*.js' tests/core/*.test.mjs",
    "coverage:workspace": "tsc -p tsconfig.workspace.json && node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-functions=65 --test-coverage-branches=60 --test-coverage-include='.workspace-build/src/frontend/**/*.js' --test-coverage-include='.workspace-build/src/shared/queries/execution/settings.js' tests/workspace/*.test.mjs",
    "coverage": "npm run coverage:core && npm run coverage:workspace",
    "review": "npm run check:syntax && npm run typecheck && npm run lint && npm run coverage && npm run build:app",
    "lint": "eslint . --max-warnings=0 && npm run lint:css && npm run format:check",
    "lint:fix": "eslint . --fix",
    "build:preview": "VITE_DEMO_MODE=true vite build && node scripts/copy-parser-vendor.mjs --web-preview",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts",
    "lint:css": "stylelint \"src/frontend/**/*.css\" --report-needless-disables --report-invalid-scope-disables --max-warnings 0",
    "format:css": "prettier --write \"src/frontend/**/*.css\"",
    "test:e2e:styles": "playwright test tests/e2e/css-appearance.spec.ts",
    "test:e2e:styles:update": "node scripts/update-style-reference.mjs",
    "format": "prettier --write \"**/*.{js,mjs,cjs,ts,tsx,css}\"",
    "format:check": "prettier --check \"**/*.{js,mjs,cjs,ts,tsx,css}\""
  },
  "dependencies": {
    "@clickhouse/click-ui": "^0.12.0",
    "@clickhouse/client": "^1.12.0",
    "@clickhouse/client-web": "1.23.1",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-sql": "^6.9.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/highlight": "^1.2.3",
    "@modelcontextprotocol/express": "^2.0.2",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.203.0",
    "d3": "^7.9.0",
    "d3-dag": "^1.2.2",
    "diff": "^9.0.0",
    "express": "^5.1.0",
    "openai": "^6.0.0",
    "patch-package": "^8.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@playwright/test": "^1.55.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.12.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.1.2"
  }
}
