{
  "name": "clickstudio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "build": "npm run typecheck && npm run build:app",
    "build:app": "vite build && tsc -p tsconfig.server.json && node scripts/copy-parser-vendor.mjs",
    "start:production": "node --env-file-if-exists=.env dist/server/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && tsc --noEmit -p tsconfig.e2e.json && tsc --noEmit -p tsconfig.root.json",
    "test": "npm run test:core && npm run test:workspace",
    "test:core": "tsc -p tsconfig.core.json && node --test tests/core/*.test.mjs",
    "test:integration": "tsx --env-file-if-exists=.env --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:core": "playwright test tests/e2e/core-workflows.spec.ts",
    "check": "npm run review",
    "eval": "tsx --env-file-if-exists=.env scripts/eval.ts",
    "eval:assistant": "tsx --env-file-if-exists=.env scripts/eval-assistant.ts",
    "init:env": "node scripts/init-env.mjs",
    "db:setup": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "check:syntax": "node scripts/check-syntax.mjs",
    "test:workspace": "tsc -p tsconfig.workspace.json && node --test tests/workspace/*.test.mjs",
    "coverage:core": "tsc -p tsconfig.core.json && node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-functions=70 --test-coverage-branches=60 --test-coverage-include='.core-build/core/**/*.js' --test-coverage-include='.core-build/shared/**/*.js' --test-coverage-include='.core-build/server/**/*.js' tests/core/*.test.mjs",
    "coverage:workspace": "tsc -p tsconfig.workspace.json && node --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-functions=65 --test-coverage-branches=60 --test-coverage-include='.workspace-build/web/**/*.js' --test-coverage-include='.workspace-build/shared/assistant-proposal.js' --test-coverage-include='.workspace-build/shared/evidence.js' --test-coverage-include='.workspace-build/shared/result-columns.js' --test-coverage-include='.workspace-build/shared/schema-browser.js' --test-coverage-include='.workspace-build/shared/types.js' --test-coverage-include='.workspace-build/shared/workspace-view.js' tests/workspace/*.test.mjs",
    "coverage": "npm run coverage:core && npm run coverage:workspace",
    "review": "npm run check:syntax && npm run typecheck && npm run lint && npm run coverage && npm run build:app",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "build:preview": "VITE_DEMO_MODE=true vite build && node scripts/copy-parser-vendor.mjs --web-preview",
    "test:e2e:preview": "playwright test --config playwright.preview.config.ts"
  },
  "dependencies": {
    "@clickhouse/click-ui": "^0.12.0",
    "@clickhouse/client": "^1.12.0",
    "@clickhouse/client-web": "1.23.1",
    "@codemirror/autocomplete": "^6.18.6",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-sql": "^6.9.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.203.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-node": "^0.203.0",
    "@tanstack/react-query": "^5.83.0",
    "d3": "^7.9.0",
    "d3-dag": "^1.2.2",
    "diff": "^9.0.0",
    "echarts": "^6.0.0",
    "express": "^5.1.0",
    "openai": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.12",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.1.2"
  }
}
